{
  "name": "webos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:check": "npm run build && node scripts/check-tokens.mjs && node scripts/check-bundle.mjs && node scripts/gen-icons.mjs --check",
    "check:tokens": "node scripts/check-tokens.mjs",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test a11y keyboard",
    "test:e2e:visual": "playwright test visual",
    "gen:app": "node scripts/gen-app.mjs",
    "icons:gen": "node scripts/gen-icons.mjs --write",
    "docs:dev": "vitepress dev website",
    "docs:gen": "node scripts/gen-api-tables.mjs --write",
    "docs:check": "node scripts/gen-api-tables.mjs --check",
    "docs:build": "node scripts/gen-api-tables.mjs --check && vitepress build website",
    "docs:preview": "vitepress preview website",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.21",
    "vue-i18n": "^11.4.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.7",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1.4"
  }
}
